{
  "name": "@onlyzoran/win-predict-ai-ui",
  "version": "0.1.7",
  "description": "Shared Vue 3 UI components for Win Predict AI (header shell, theme, locale)",
  "type": "module",
  "files": [
    "dist",
    "src/themes"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./themes": "./src/themes/index.css",
    "./themes/zinc.css": "./src/themes/zinc.css",
    "./themes/slate-teal.css": "./src/themes/slate-teal.css",
    "./themes/claude-plus.css": "./src/themes/claude-plus.css"
  },
  "sideEffects": [
    "src/themes/**/*.css"
  ],
  "scripts": {
    "build": "vite build && vue-tsc --declaration --emitDeclarationOnly -p tsconfig.build.json",
    "type-check": "vue-tsc --noEmit -p tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@onlyzoran/win-predict-ai-icons": "^0.14.0",
    "@vueuse/core": "^14.0.0",
    "reka-ui": "^2.0.0",
    "vue": "^3.3.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@onlyzoran/win-predict-ai-icons": "^0.14.0",
    "@storybook/addon-docs": "^9.1.20",
    "@storybook/vue3": "^9.1.20",
    "@storybook/vue3-vite": "^9.1.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vueuse/core": "^14.4.0",
    "reka-ui": "^2.10.1",
    "storybook": "^9.1.20",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vue": "^3.5.40",
    "vue-tsc": "^3.1.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/onlyzoran/win-predict-ai-ui.git"
  },
  "homepage": "https://github.com/onlyzoran/win-predict-ai-ui#readme",
  "bugs": {
    "url": "https://github.com/onlyzoran/win-predict-ai-ui/issues"
  },
  "license": "UNLICENSED",
  "keywords": [
    "vue",
    "ui",
    "shadcn",
    "win-predict-ai"
  ]
}
